+/* Adaptive safe-viewport opt-in (RA3_SAFE_VIEWPORT).
+ *
+ * The raw monitor extents exposed to Wine come from NSScreen.frame scaled by
+ * the retina factor, while the DEVMODE dimensions double
+ * CGDisplayModeGetWidth()/GetHeight() only when a mode matches the descriptor
+ * captured at startup. When the live mode no longer matches that descriptor
+ * (scaled resolutions, or the mode changed after startup), the doubled
+ * dimensions disagree with the raw extents.
+ *
+ * While a valid RA3_SAFE_VIEWPORT selects the native panel size and the main
+ * display's CURRENT mode is the retina 2x variant of that size, callers may
+ * force the retina 2x dimensions for the main display regardless of the
+ * startup descriptor. Like display_mode_to_devmode_fields, the comparison is
+ * normalized for 90/270 display rotation by swapping the mode dimensions.
+ * The live mode is re-checked on every call (never cached), so a later mode
+ * change silently reverts to the stock descriptor-based behaviour. With
+ * RA3_SAFE_VIEWPORT absent or invalid this always returns FALSE. */
+static BOOL ra3_adaptive_retina_2x(void)
+{
+    Ra3ViewportSpec spec;
+    const char *env = getenv(RA3_VIEWPORT_ENV);
+    CGDisplayModeRef mode;
+    BOOL ret = FALSE;
+
+    if (!env || !ra3_parse_viewport_spec(env, &spec) || !retina_enabled)
+        return FALSE;
+
+    mode = CGDisplayCopyDisplayMode(kCGDirectMainDisplay);
+    if (mode)
+    {
+        /* Rotation quadrant as computed by display_mode_to_devmode_fields. */
+        double rotation = CGDisplayRotation(kCGDirectMainDisplay);
+        int quadrant = ((int)((rotation / 90) + 0.5)) % 4;
+        size_t width = CGDisplayModeGetWidth(mode) * 2;
+        size_t height = CGDisplayModeGetHeight(mode) * 2;
+        CGDisplayModeRelease(mode);
+
+        if (quadrant == 1 || quadrant == 3)
+        {
+            size_t swap = width;
+            width = height;
+            height = swap;
+        }
+
+        ret = (size_t)spec.screen_width == width && (size_t)spec.screen_height == height;
+    }
+    return ret;
+}
