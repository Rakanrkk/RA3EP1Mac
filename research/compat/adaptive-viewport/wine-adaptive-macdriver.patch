+/* Adaptive safe-viewport opt-in (RA3_SAFE_VIEWPORT): TRUE while a valid
+ * viewport spec is configured, FALSE when the variable is absent or invalid.
+ * An invalid value disables both the adaptive route and the legacy
+ * RA3_FIXED_VIEWPORT fallback, matching the win32u routes. */
+static BOOL ra3_safe_viewport_valid(void)
+{
+    Ra3ViewportSpec spec;
+    const char *env = getenv(RA3_VIEWPORT_ENV);
+
+    return env && ra3_parse_viewport_spec(env, &spec);
+}
+
+
+/* Actual backing scale of the screen the view is on, or of the screen owning
+ * the main CG display when the view is not in a window yet (first layer
+ * creation). The main display is matched by the screen's NSScreenNumber
+ * device description, not the focus-dependent [NSScreen mainScreen]. Returns
+ * 0.0 when no screen matches, in which case the caller keeps the stock Wine
+ * scale. */
+static CGFloat ra3_adaptive_screen_scale(NSView* view)
+{
+    NSScreen* screen = [view window].screen;
+    CGFloat scale = 0.0;
+
+    if (!screen)
+    {
+        CGDirectDisplayID main_display = CGMainDisplayID();
+        for (NSScreen* candidate in [NSScreen screens])
+        {
+            NSNumber* display_id = [candidate.deviceDescription objectForKey:@"NSScreenNumber"];
+            if (display_id && (CGDirectDisplayID)[display_id unsignedIntValue] == main_display)
+            {
+                screen = candidate;
+                break;
+            }
+        }
+    }
+
+    if (screen) scale = [screen backingScaleFactor];
+    return scale;
+}
+
