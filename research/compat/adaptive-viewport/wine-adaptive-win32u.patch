+/* Native cursor poll clamp gate.  RA3_SAFE_VIEWPORT takes precedence: when
+ * present it must parse as a strict raw-edge spec or the clamp stays off
+ * with no legacy fallback; the exact "3024x1900" legacy route only applies
+ * when RA3_SAFE_VIEWPORT is absent.  The mapped monitor rect already carries
+ * the viewport geometry, so only this gate changes. */
+static int ra3_cursor_clamp_enabled( void )
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *value = getenv( RA3_VIEWPORT_ENV );
+
+        if (value)
+        {
+            Ra3ViewportSpec spec;
+            enabled = ra3_parse_viewport_spec( value, &spec );
+        }
+        else
+        {
+            value = getenv( "RA3_FIXED_VIEWPORT" );
+            enabled = value && !strcmp( value, "3024x1900" );
+        }
+    }
+    return enabled;
+}
