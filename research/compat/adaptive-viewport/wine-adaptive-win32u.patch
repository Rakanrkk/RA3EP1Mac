+/* Active RA3 viewport override for the isolated fullscreen candidate.
+ * RA3_SAFE_VIEWPORT takes precedence over the legacy exact "3024x1900"
+ * RA3_FIXED_VIEWPORT route: when present it must parse as a strict raw-edge
+ * spec, and an invalid value disables every override with no legacy
+ * fallback; the legacy route only stays available when the new variable is
+ * absent. */
+enum ra3_viewport_route
+{
+    RA3_VIEWPORT_NONE = 0,
+    RA3_VIEWPORT_SAFE,
+    RA3_VIEWPORT_FIXED,
+};
+
+static int ra3_viewport_route( Ra3ViewportSpec *spec )
+{
+    static int cached = -1;
+    static Ra3ViewportSpec cached_spec;
+
+    if (cached == -1)
+    {
+        const char *value = getenv( RA3_VIEWPORT_ENV );
+
+        if (value)
+        {
+            /* Boolean parse: 1 means the strict spec is valid. */
+            if (ra3_parse_viewport_spec( value, &cached_spec )) cached = RA3_VIEWPORT_SAFE;
+            else cached = RA3_VIEWPORT_NONE;
+        }
+        else
+        {
+            value = getenv( "RA3_FIXED_VIEWPORT" );
+            if (value && !strcmp( value, "3024x1900" )) cached = RA3_VIEWPORT_FIXED;
+            else cached = RA3_VIEWPORT_NONE;
+        }
+    }
+    if (spec && cached == RA3_VIEWPORT_SAFE) *spec = cached_spec;
+    return cached;
+}
