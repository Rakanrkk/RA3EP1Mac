+/* Opt-in viewport for the isolated RA3 fullscreen candidate.  Keep the
+ * existing raw/virtual conversions and server pointer mapping; only change
+ * their destination rectangle.  Unset or unsupported displays remain stock. */
+static BOOL ra3_fixed_viewport( struct monitor *monitor, const DEVMODEW *physical, RECT *rect )
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *value = getenv( "RA3_FIXED_VIEWPORT" );
+        enabled = value && !strcmp( value, "3024x1900" );
+    }
+    if (!enabled || !is_monitor_primary( monitor ) ||
+        physical->dmPelsWidth < 3024 || physical->dmPelsHeight < 1900) return FALSE;
+
+    rect->left = physical->dmPosition.x + (physical->dmPelsWidth - 3024) / 2;
+    rect->right = rect->left + 3024;
+    rect->bottom = physical->dmPosition.y + physical->dmPelsHeight;
+    rect->top = rect->bottom - 1900;
+    return TRUE;
+}
+
 /* display_lock must be held */
 static RECT map_monitor_rect( struct monitor *monitor, RECT rect, UINT dpi_from, MONITOR_DPI_TYPE type_from,
