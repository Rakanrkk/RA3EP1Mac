+                virt = map_dpi_rect( virt, effective_dpi, dpi );
+                src = type_from == MDT_DEFAULT ? virt : viewport;
+                dst = type_from == MDT_DEFAULT ? viewport : virt;
+                if (src.right > src.left && src.bottom > src.top)
